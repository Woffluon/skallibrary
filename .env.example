# Django Production Environment Configuration Example
# Copy this file to .env and configure values for production

DJANGO_SECRET_KEY=replace-with-a-very-long-random-secret-key-at-least-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=kutuphane.skal.k12.tr,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://kutuphane.skal.k12.tr

# Security (SSL / HTTPS)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Email (SMTP in production)
DJANGO_ADMIN_EMAIL=admin@skal.k12.tr
DJANGO_DEFAULT_FROM_EMAIL=noreply@skal.k12.tr
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=kutuphane@skal.k12.tr
DJANGO_EMAIL_HOST_PASSWORD=your-app-password
